# Multi-stage build for Godis with Web Todo feature
FROM golang:1.21-alpine AS builder

# Install git and build dependencies
RUN apk add --no-cache git ca-certificates tzdata

# Set working directory
WORKDIR /build

# Copy go mod and sum files
COPY go.mod go.sum ./

# Download dependencies
RUN go mod download

# Copy source code
COPY . .

# Build the application
RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o webtodo-server ./cmd/webtodo-server

# Final stage
FROM alpine:latest

# Install ca-certificates for HTTPS requests
RUN apk --no-cache add ca-certificates tzdata

# Create app directory
WORKDIR /app

# Create non-root user
RUN addgroup -g 1001 -S godis && \
    adduser -u 1001 -S godis -G godis

# Copy binary from builder stage
COPY --from=builder /build/webtodo-server /app/webtodo-server

# Copy configuration files
COPY webtodo.conf /app/webtodo.conf

# Copy static files for web interface
COPY webtodo/static /app/webtodo/static

# Create data directory with proper permissions
RUN mkdir -p /app/data /app/logs && \
    chown -R godis:godis /app

# Switch to non-root user
USER godis

# Expose ports
EXPOSE 6399 8080

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:8080/ || exit 1

# Set default environment variables
ENV ENABLE_WEB_TODO=true
ENV WEB_TODO_PORT=8080
ENV WEB_TODO_STATIC_DIR=/app/webtodo/static

# Default command
CMD ["./webtodo-server", "--config", "webtodo.conf", "--enable-web-todo"]